{
  "name": "codebaer",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "scripts": {
    "dev": "pnpm --filter @codebaer/ui --fail-if-no-match dev",
    "build": "pnpm --filter @codebaer/ui --fail-if-no-match build",
    "typecheck": "pnpm --filter @codebaer/ui --fail-if-no-match typecheck",
    "lint": "pnpm --filter @codebaer/ui --fail-if-no-match lint",
    "test": "vitest run",
    "ui": "pnpm --filter @codebaer/ui --fail-if-no-match ui",
    "e2e": "pnpm --filter @codebaer/ui --fail-if-no-match e2e",
    "shot": "pnpm --filter @codebaer/ui --fail-if-no-match shot",
    "tauri": "tauri",
    "bump": "node scripts/bump.mjs"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "vitest": "^5.0.0"
  }
}
