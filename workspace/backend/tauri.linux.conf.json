{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "codebaer",
  "app": {
    "windows": [{
      "create": false,
      "title": "CodeBär",
      "visible": false,
      "width": 1280,
      "height": 820,
      "minWidth": 900,
      "minHeight": 560
    }]
  },
  "bundle": {
    "targets": ["deb", "rpm"],
    "category": "DeveloperTool",
    "shortDescription": "Review what an AI agent changed in a git working tree",
    "longDescription": "Shows the unstaged changes of a git working tree as a queue of hunks to accept, reject or edit, with a built-in terminal for the agent.",
    "icon": ["icons/32x32.png", "icons/64x64.png", "icons/128x128.png", "icons/icon.png"],
    "linux": {
      "deb": {
        "desktopTemplate": "linux/codebaer.desktop",
        "depends": ["git", "libc6 (>= 2.34)"],
        "recommends": ["xdg-utils"]
      },
      "rpm": {
        "desktopTemplate": "linux/codebaer.desktop",
        "depends": ["git", "libc.so.6(GLIBC_2.34)(64bit)"],
        "recommends": ["xdg-utils"]
      }
    }
  }
}
